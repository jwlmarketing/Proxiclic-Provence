# Proxiclic-Provence — configuration Apache

# --- Page d'erreur 404 personnalisée ---
ErrorDocument 404 /404.html

# --- Forcer HTTPS et la version www ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirige http:// vers https://
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirige proxiclic-provence.fr vers www.proxiclic-provence.fr
  RewriteCond %{HTTP_HOST} ^proxiclic-provence\.fr$ [NC]
  RewriteRule ^ https://www.proxiclic-provence.fr%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Désactiver l'affichage du contenu des dossiers ---
Options -Indexes

# --- Compression des fichiers texte ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Mise en cache navigateur ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- En-têtes de sécurité de base ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Encodage par défaut ---
AddDefaultCharset UTF-8
